# ─── SignalVault — copy to .env and fill in ─────────────────────────────
# The backend (backend/) reads these. The frontend only needs VITE_API_BASE_URL.

# Frontend → backend URL (used by `bun run dev`; the app also reads it from
# localStorage key "skypredictr_api_base" at runtime)
VITE_API_BASE_URL=http://localhost:8080

# ── Database (Neon Postgres — required) ──
# Get one free at neon.tech, or via the Vercel Postgres integration.
DATABASE_URL=postgres://user:password@ep-xxxx.aws.neon.tech/neondb?sslmode=require
# POSTGRES_URL=  (fallback — Vercel's Neon integration sets this automatically)

# ── ShinobiPay (Ghana instant MoMo — required for paid flows) ──
# The house gateway (rebranded AkwaPay). Get keys from ShinobiPay → Developers.
APP_SHINOBIPAY_SECRET_KEY=
APP_SHINOBIPAY_WEBHOOK_SECRET=
# APP_SHINOBIPAY_BASE_URL=https://akwapayapi.onrender.com/v1

# ── First super-admin (created on startup if missing) ──
SUPERADMIN_USERNAME=superadmin@platform.com
SUPERADMIN_PASSWORD=change-me-immediately
ADMIN_SESSION_DURATION_HOURS=12

# ── Referral commission split ──
REFERRAL_DEFAULT_ADMIN_SHARE_PERCENT=30

# ── ImgBB (payment-proof uploads — server-side only, never in the browser) ──
IMGBB_API_KEY=

# ── AI slip scanning (OpenRouter; comma-separated keys, up to 4 accounts) ──
AI_OPENROUTER_API_KEYS=
# AI_OPENROUTER_API_KEY=  (single-key alternative)

# ── Frontend URLs used in payment links/callbacks ──
# Set these to the real deployed origin (the SignalVault Vercel URL) —
# SSR loaders fall back to http://127.0.0.1:8080 when they are unset.
APP_FRONTEND_BASE_URL=https://signalvault.example.com
APP_PLATFORM_FRONTEND_URL=https://signalvault.example.com

# ── Cron (Vercel Cron hits /api/cron/reconcile every 5 min) ──
CRON_SECRET=

# ── Misc ──
ACCOUNT_PASSWORD_LENGTH=10
PORT=8080
